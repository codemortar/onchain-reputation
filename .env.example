# Free key from https://etherscan.io/apis (register, then Dashboard -> API Keys).
# Copy this file to .env.local and fill it in. .env.local is gitignored.
ETHERSCAN_API_KEY=

# Optional. Milliseconds between explorer requests. Default 400 (2.5/sec),
# chosen to sit under the 3/sec limit some free keys have. Lower it on a paid
# tier; raise it if you still see rate-limit retries in the logs.
# ETHERSCAN_MIN_SPACING_MS=400

# Optional. Defaults to a public endpoint, which is fine for development but
# rate-limited and has no SLA. Point this at your own node or a provider
# (Alchemy, Infura, dRPC) for anything serious.
# ETHEREUM_RPC_URL=
